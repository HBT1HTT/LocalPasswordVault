<Window x:Class="LocalPasswordVault.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="520"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="删除保护"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <Border Margin="0,16,0,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel>
                        <CheckBox x:Name="RequireCheck"
                                  Content="每次删除都验证身份（推荐）"
                                  FontSize="14"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  IsChecked="True"
                                  Click="RequireCheck_Click" />
                        <TextBlock Text="开启后，每次删除条目都会先调用 Windows Hello 验证身份；关闭后，删除条目不再验证，但程序启动时的解锁验证仍然必须通过。关闭此开关（降低保护）需要先通过 Windows Hello 验证；重新开启（提高保护）不需要验证。"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="UnavailableText"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"
                           Text="当前 Windows 未配置 PIN 或 Windows Hello，无法验证身份，因此不能关闭此项保护；删除操作也会被阻止。请先在系统设置中配置后再使用。" />

                <TextBlock Text="闲置自动锁定"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,20,0,0" />

                <Border Margin="0,12,0,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="超过设定时长没有任何鼠标 / 键盘操作时，程序会自动回到锁定状态，并重新要求 Windows Hello 验证。"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <ComboBox x:Name="AutoLockCombo"
                                  Width="240"
                                  FontSize="14"
                                  Margin="0,12,0,0"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="AutoLockCombo_SelectionChanged">
                            <ComboBoxItem Content="1 分钟" />
                            <ComboBoxItem Content="5 分钟（默认）" />
                            <ComboBoxItem Content="10 分钟" />
                            <ComboBoxItem Content="30 分钟" />
                            <ComboBoxItem Content="关闭自动锁定（不推荐）" />
                        </ComboBox>
                        <TextBlock x:Name="AutoLockWarning"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="Collapsed"
                                   Text="已关闭自动锁定：密码库会长时间保持解锁状态，离开电脑时他人可直接查看已解密内容。建议保持开启。" />
                    </StackPanel>
                </Border>

                <TextBlock Text="数据备份"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,20,0,0" />

                <Border Margin="0,12,0,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="用自设主密码把密码库加密成独立的备份文件，可在其他电脑上输入主密码恢复，不再受本机 Windows 账户限制。导入会覆盖当前数据库，覆盖前会自动备份当前数据库。"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="ExportBackupButton"
                                    Content="导出加密备份"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ExportBackupButton_Click" />
                            <Button x:Name="ImportBackupButton"
                                    Content="导入加密备份"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ImportBackupButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="关闭"
                    Style="{StaticResource SecondaryButton}"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
