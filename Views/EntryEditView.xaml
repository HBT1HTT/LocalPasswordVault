<UserControl x:Class="LocalPasswordVault.Views.EntryEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <Grid Background="{StaticResource PageBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Width="560"
                    Margin="0,24"
                    Padding="32,28"
                    CornerRadius="12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Text="新建密码条目"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="账号、密码、附加信息会使用 Windows DPAPI 加密后保存，数据库内只存密文。"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,22,0,0">
                        <TextBlock Text="名称（必填）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" MaxLength="200" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="账号" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UsernameBox" Style="{StaticResource FieldTextBox}" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PasswordBox" Style="{StaticResource FieldTextBox}" FontFamily="Consolas" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="附加信息" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ExtraBox"
                                 Height="120"
                                 Style="{StaticResource FieldTextBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" />
                    </StackPanel>

                    <TextBlock x:Name="ErrorText"
                               Margin="0,14,0,0"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,22,0,0">
                        <Button Content="取消"
                                Style="{StaticResource SecondaryButton}"
                                Click="CancelButton_Click" />
                        <Button Content="保存"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
