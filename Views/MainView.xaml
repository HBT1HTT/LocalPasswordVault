<UserControl x:Class="LocalPasswordVault.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <TextBlock Text="本地密码库"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionHint"
                               Text="请先选择一个条目"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Visibility="Collapsed" />
                    <Button x:Name="DeleteButton"
                            Content="删除"
                            Style="{StaticResource SecondaryButton}"
                            Foreground="{StaticResource DangerBrush}"
                            IsEnabled="False"
                            Margin="0,0,8,0"
                            Click="DeleteButton_Click" />
                    <Button Content="新建"
                            Style="{StaticResource PrimaryButton}"
                            Click="NewButton_Click" />
                    <Button Content="设置"
                            Style="{StaticResource LinkButton}"
                            Margin="14,0,0,0"
                            Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 条目列表 -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6">
                <Grid>
                    <ListBox x:Name="EntryList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="EntryList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#E0EAFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyState"
                               Text="还没有密码条目，点击新建添加"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="16"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 详情区 -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <StackPanel x:Name="DetailEmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24">
                        <TextBlock Text="从左侧选择一个条目查看详情"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="DetailErrorPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                Margin="24"
                                Visibility="Collapsed">
                        <TextBlock x:Name="DetailErrorText"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <Grid x:Name="DetailPanel" Margin="24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="DetailName"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,20,0,0">
                            <TextBlock Text="账号" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="UsernameText"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
                            <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PasswordText"
                                         Grid.Column="0"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         FontFamily="Consolas"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         TextWrapping="Wrap" />
                                <Button x:Name="TogglePasswordButton"
                                        Grid.Column="1"
                                        Content="显示"
                                        Style="{StaticResource LinkButton}"
                                        Click="TogglePasswordButton_Click" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,16,0,0">
                            <TextBlock Text="附加信息" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ExtraText"
                                     Height="120"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Background="#F8FAFC"
                                     BorderBrush="{StaticResource LineBrush}"
                                     BorderThickness="1"
                                     Padding="8"
                                     Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <Button Content="编辑"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="EditButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
