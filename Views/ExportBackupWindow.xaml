<Window x:Class="LocalPasswordVault.Views.ExportBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出加密备份"
        Width="480"
        Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI">
    <Border Margin="24"
            Padding="24"
            CornerRadius="12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="设置备份主密码"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="备份文件会用这个主密码加密，与 Windows 账户无关，换电脑后输入同一密码即可恢复。请妥善保存，忘记后无法找回。"
                       Margin="0,8,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />

            <TextBlock Text="主密码（至少 8 位，需同时包含字母和数字）"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,20,0,6" />
            <PasswordBox x:Name="PasswordInput"
                         Style="{StaticResource FieldPasswordBox}"
                         MaxLength="128" />

            <TextBlock Text="再次输入主密码"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,14,0,6" />
            <PasswordBox x:Name="ConfirmInput"
                         Style="{StaticResource FieldPasswordBox}"
                         MaxLength="128" />

            <TextBlock x:Name="ErrorText"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        Click="CancelButton_Click" />
                <Button Content="下一步"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="NextButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
