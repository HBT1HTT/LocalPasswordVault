<Window x:Class="LocalPasswordVault.Views.ImportBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入加密备份"
        Width="540"
        Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI">
    <Border Margin="24"
            Padding="24"
            CornerRadius="12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="选择备份文件"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="导入会用备份中的条目覆盖当前密码库，覆盖前会自动备份当前数据库。"
                       Margin="0,8,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />

            <TextBlock Text="备份文件（.vault）"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,20,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathText"
                         Grid.Column="0"
                         IsReadOnly="True"
                         Style="{StaticResource FieldTextBox}"
                         TextWrapping="NoWrap" />
                <Button Grid.Column="1"
                        Content="浏览…"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BrowseButton_Click" />
            </Grid>

            <TextBlock Text="主密码"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,14,0,6" />
            <PasswordBox x:Name="PasswordInput"
                         Style="{StaticResource FieldPasswordBox}"
                         MaxLength="128" />

            <TextBlock x:Name="ErrorText"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        Click="CancelButton_Click" />
                <Button Content="开始导入"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="ImportButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
